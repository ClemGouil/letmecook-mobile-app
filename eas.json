{
  "cli": {
    "version": ">= 18.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_URL_BACKEND": "http://192.168.1.83:8080"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_URL_BACKEND": "https://letmecook-backend.mblabs.fr"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_URL_BACKEND": "https://letmecook-backend.mblabs.fr"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
